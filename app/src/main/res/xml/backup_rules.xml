<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!--
   <include domain="sharedpref" path="."/>
   <exclude domain="sharedpref" path="device.xml"/>
-->

        <!-- Store downloads/ad capabilities are installation-local; permanent ownership comes from the server. -->
        <exclude domain="sharedpref" path="content-store-operations.xml"/>
        <exclude domain="file" path="content_store/"/>
        <exclude domain="file" path="downloaded_sprites/"/>
        <exclude domain="file" path="downloaded_backdrops/"/>
        <exclude domain="file" path="downloaded_sounds/"/>
</full-backup-content>