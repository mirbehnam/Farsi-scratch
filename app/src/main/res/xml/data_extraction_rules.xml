<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Store downloads/ad capabilities are installation-local; permanent ownership comes from the server. -->
        <exclude domain="sharedpref" path="content-store-operations.xml"/>
        <exclude domain="file" path="content_store/"/>
        <exclude domain="file" path="downloaded_sprites/"/>
        <exclude domain="file" path="downloaded_backdrops/"/>
        <exclude domain="file" path="downloaded_sounds/"/>

        <!-- TODO: Use <include> and <exclude> to control what is backed up.
        <include .../>
        <exclude .../>
        -->
    </cloud-backup>
    <!--
    <device-transfer>
        <include .../>
        <exclude .../>
    </device-transfer>
    -->
    <device-transfer>
        <!-- Store downloads/ad capabilities are installation-local; permanent ownership comes from the server. -->
        <exclude domain="sharedpref" path="content-store-operations.xml"/>
        <exclude domain="file" path="content_store/"/>
        <exclude domain="file" path="downloaded_sprites/"/>
        <exclude domain="file" path="downloaded_backdrops/"/>
        <exclude domain="file" path="downloaded_sounds/"/>
    </device-transfer>
</data-extraction-rules>